#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char s[100];
    int k, i;

    printf("Enter text: ");
    fgets(s, sizeof(s), stdin);
    printf("Enter key: ");
    scanf("%d", &k);
    k = (k % 26 + 26) % 26;

    for (i = 0; s[i]; i++) {
        if (isupper(s[i]))
            s[i] = (s[i] - 'A' + k) % 26 + 'A';
        else if (islower(s[i]))
            s[i] = (s[i] - 'a' + k) % 26 + 'a';
    }

    printf("Ciphertext: %s", s);
    return 0;
}

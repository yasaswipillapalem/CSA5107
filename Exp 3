#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char key[] = "MONARCHY";
    char text[100], a[26] = "";
    int used[26] = {0}, r, c, i, n = 0;
    char m[5][5], x, y;

    for (i = 0; key[i]; i++) {
        x = toupper(key[i]);
        if (x == 'J') x = 'I';
        if (!used[x-'A']) {
            a[n++] = x;
            used[x-'A'] = 1;
        }
    }
    for (x = 'A'; x <= 'Z'; x++)
        if (x != 'J' && !used[x-'A'])
            a[n++] = x;

    for (i = 0; i < 25; i++)
        m[i/5][i%5] = a[i];

    printf("Enter plaintext: ");
    scanf("%99s", text);

    char p[200];
    n = 0;
    for (i = 0; text[i]; i++) {
        x = toupper(text[i]);
        if (!isalpha(x)) continue;
        if (x == 'J') x = 'I';
        p[n++] = x;
    }
    p[n] = '\0';

    char out[200];
    int k = 0;
    for (i = 0; i < n; i += 2) {
        x = p[i];
        y = (i+1 < n) ? p[i+1] : 'X';
        if (x == y) y = 'X';

        int r1=-1,c1=-1,r2=-1,c2=-1;
        for (r=0;r<5;r++)
            for(c=0;c<5;c++) {
                if(m[r][c]==x) r1=r,c1=c;
                if(m[r][c]==y) r2=r,c2=c;
            }

        if(r1==r2) {
            out[k++]=m[r1][(c1+1)%5];
            out[k++]=m[r2][(c2+1)%5];
        } else if(c1==c2) {
            out[k++]=m[(r1+1)%5][c1];
            out[k++]=m[(r2+1)%5][c2];
        } else {
            out[k++]=m[r1][c2];
            out[k++]=m[r2][c1];
        }
    }
    out[k]='\0';
    printf("Ciphertext: %s\n", out);
    return 0;
}

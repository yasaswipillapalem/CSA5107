#include <stdio.h>

int main() {
    int p[4]={0,0,0,1};
    int iv=10,i,c[4];

    printf("CBC XOR demonstration\n");
    for(i=0;i<4;i++) {
        c[i]=p[i] ^ (iv & 1);
        iv=c[i];
        printf("Block %d: %d\n",i+1,c[i]);
    }

    printf("Note: This illustrates XOR chaining, not S-DES.\n");
    return 0;
}

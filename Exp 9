#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char key[100], s[500], m[5][5], used[26]={0};
    char alphabet[26];
    int i, j, n=0, r, c;

    printf("Enter keyword: ");
    scanf("%99s", key);

    for(i=0; key[i]; i++) {
        char x=toupper(key[i]);
        if(x=='J') x='I';
        if(x>='A' && x<='Z' && !used[x-'A']) {
            alphabet[n++]=x;
            used[x-'A']=1;
        }
    }

    for(i=0;i<26;i++)
        if(i!='J'-'A' && !used[i])
            alphabet[n++]='A'+i;

    for(i=0;i<25;i++)
        m[i/5][i%5]=alphabet[i];

    printf("Enter ciphertext (letters in pairs): ");
    scanf("%499s",s);

    for(i=0;s[i] && s[i+1];i+=2) {
        char x=toupper(s[i]), y=toupper(s[i+1]);
        int r1=0,c1=0,r2=0,c2=0;

        if(x=='J') x='I';
        if(y=='J') y='I';

        for(r=0;r<5;r++)
            for(c=0;c<5;c++) {
                if(m[r][c]==x) r1=r,c1=c;
                if(m[r][c]==y) r2=r,c2=c;
            }

        if(r1==r2) {
            x=m[r1][(c1+4)%5];
            y=m[r2][(c2+4)%5];
        } else if(c1==c2) {
            x=m[(r1+4)%5][c1];
            y=m[(r2+4)%5][c2];
        } else {
            char t=m[r1][c2];
            y=m[r2][c1];
            x=t;
        }

        printf("%c%c",x,y);
    }
    printf("\n");
    return 0;
}

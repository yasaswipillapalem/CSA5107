#include <stdio.h>
#include <ctype.h>

int main() {
    char m[5][5] = {
        {'M','F','H','I','K'},
        {'U','N','O','P','Q'},
        {'Z','V','W','X','Y'},
        {'E','L','A','R','G'},
        {'D','S','T','B','C'}
    };

    char s[200], p[400], out[400];
    int i,n=0,k=0,r,c;

    printf("Enter plaintext: ");
    fgets(s,sizeof(s),stdin);

    for(i=0;s[i];i++)
        if(isalpha(s[i])) {
            char x=toupper(s[i]);
            if(x=='J') x='I';
            p[n++]=x;
        }

    for(i=0;i<n;i+=2) {
        char x=p[i], y=(i+1<n)?p[i+1]:'X';
        if(x==y) y='X';

        int r1=0,c1=0,r2=0,c2=0;

        for(r=0;r<5;r++)
            for(c=0;c<5;c++) {
                if(m[r][c]==x) r1=r,c1=c;
                if(m[r][c]==y) r2=r,c2=c;
            }

        if(r1==r2) {
            out[k++]=m[r1][(c1+1)%5];
            out[k++]=m[r2][(c2+1)%5];
        } else if(c1==c2) {
            out[k++]=m[(r1+1)%5][c1];
            out[k++]=m[(r2+1)%5][c2];
        } else {
            out[k++]=m[r1][c2];
            out[k++]=m[r2][c1];
        }
    }

    out[k]='\0';
    printf("Ciphertext: %s\n",out);
    return 0;
}

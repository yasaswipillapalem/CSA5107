#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main() {
    char text[100], key[100];
    int i, j = 0;

    printf("Enter plaintext: ");
    scanf("%99s", text);
    printf("Enter key: ");
    scanf("%99s", key);

    for (i = 0; text[i]; i++) {
        int p = toupper(text[i]) - 'A';
        int k = toupper(key[j % strlen(key)]) - 'A';
        text[i] = (p + k) % 26 + 'A';
        j++;
    }

    printf("Ciphertext: %s\n", text);
    return 0;
}
